.create-merge table EquipmentTelemetry (event_id:string, run_id:string, event_time:datetime, sequence_number:long, installation_id:string, installation_name:string, tag_id:string, tag_number:string, equipment_class_name:string, operating_state:string, temperature_c:real, vibration_mm_s:real, pressure_bar:real, motor_current_a:real, anomaly_type:string)
.create-or-alter table EquipmentTelemetry ingestion json mapping 'TelemetryJson' '[{"column":"event_id","path":"$.event_id"},{"column":"run_id","path":"$.run_id"},{"column":"event_time","path":"$.event_time"},{"column":"sequence_number","path":"$.sequence_number"},{"column":"installation_id","path":"$.installation_id"},{"column":"installation_name","path":"$.installation_name"},{"column":"tag_id","path":"$.tag_id"},{"column":"tag_number","path":"$.tag_number"},{"column":"equipment_class_name","path":"$.equipment_class_name"},{"column":"operating_state","path":"$.operating_state"},{"column":"temperature_c","path":"$.temperature_c"},{"column":"vibration_mm_s","path":"$.vibration_mm_s"},{"column":"pressure_bar","path":"$.pressure_bar"},{"column":"motor_current_a","path":"$.motor_current_a"},{"column":"anomaly_type","path":"$.anomaly_type"}]'
.alter table EquipmentTelemetry policy retention '{"SoftDeletePeriod":"7.00:00:00","Recoverability":"Enabled"}'
.alter table EquipmentTelemetry policy ingestionbatching '{"MaximumBatchingTimeSpan":"00:00:10","MaximumNumberOfItems":100,"MaximumRawDataSizeMB":100}'
