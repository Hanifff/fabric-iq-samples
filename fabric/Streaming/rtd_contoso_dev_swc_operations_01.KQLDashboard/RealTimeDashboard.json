  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b405ef26-6d8d-5965-b7b4-c56b574bc945"
      },
      "text": "EquipmentTelemetry\n| summarize arg_max(event_time, *) by tag_id\n| project event_time, installation_name, tag_number, equipment_class_name, temperature_c, vibration_mm_s, pressure_bar, motor_current_a, anomaly_type\n| order by tag_number asc",
      "id": "77cec659-a724-5c82-a058-8a7c4c6b358d",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b405ef26-6d8d-5965-b7b4-c56b574bc945"
      },
      "text": "EquipmentTelemetry | where event_time between (_startTime .. _endTime)\n| summarize temperature_c = avg(temperature_c) by bin(event_time, 10s), tag_number",
      "id": "0951bef5-c022-5651-af2a-a4265a52c26f",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b405ef26-6d8d-5965-b7b4-c56b574bc945"
      },
      "text": "EquipmentTelemetry | where event_time between (_startTime .. _endTime)\n| summarize vibration_mm_s = avg(vibration_mm_s) by bin(event_time, 10s), tag_number",
      "id": "a74463e6-3941-5bdc-b3fa-efc63fe73ac1",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b405ef26-6d8d-5965-b7b4-c56b574bc945"
      },
      "text": "EquipmentTelemetry | where event_time between (_startTime .. _endTime)\n| where anomaly_type != \"None\"\n| summarize readings = count(), peak_temperature_c = max(temperature_c), peak_vibration_mm_s = max(vibration_mm_s), first_seen = min(event_time), last_seen = max(event_time) by installation_name, tag_number, anomaly_type\n| order by last_seen desc",
      "id": "5266466a-7ddd-5e95-9d6c-3da70f86d0c6",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b405ef26-6d8d-5965-b7b4-c56b574bc945"
      },
      "text": "EquipmentTelemetry | where event_time between (_startTime .. _endTime)\n| summarize readings = count() by bin(event_time, 1m)",
      "id": "ac3ac878-4e71-56fd-bff1-3ee1166d5c4f",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    }
  ],
