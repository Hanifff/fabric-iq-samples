	column 'Project Key'
		dataType: int64
		isHidden
		lineageTag: a827f60f-f98f-5428-ba99-79efeeb69831
		sourceLineageTag: project_key
		summarizeBy: none
		sourceColumn: project_key

		annotation SummarizationSetBy = Automatic

	/// Business identifier of the project in the source system, for example PRJ-2210.
	column 'Project ID'
		dataType: string
		lineageTag: 6d1e5c59-69ee-56e6-aefa-774716109130
		sourceLineageTag: project_id
		summarizeBy: none
		sourceColumn: project_id

