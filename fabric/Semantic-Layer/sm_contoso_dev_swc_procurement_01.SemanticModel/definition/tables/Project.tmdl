/// One row per Contoso project: a fabrication, modification, maintenance or study contract for a client. Shared by planning and procurement.
table Project
	lineageTag: a5ec6777-417a-553a-b514-f8c7c273f4a4
	sourceLineageTag: [dbo].[dim_project]

