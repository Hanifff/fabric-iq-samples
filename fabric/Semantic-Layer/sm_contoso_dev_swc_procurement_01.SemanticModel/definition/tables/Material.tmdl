/// Materials and equipment that Contoso buys, with group, unit and standard price.
table Material
	lineageTag: 1dc8a9b8-d634-575a-8c03-2bd578c52ec3
	sourceLineageTag: [dbo].[dim_material]

	/// Surrogate key of the material.
