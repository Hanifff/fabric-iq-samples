		isHidden
		lineageTag: c5f4c9f4-f139-50fc-b758-dd4e10cce612
		sourceLineageTag: material_key
		summarizeBy: none
		sourceColumn: material_key

		annotation SummarizationSetBy = Automatic

	/// Business identifier of the material, for example MAT-00231.
	column 'Material ID'
		dataType: string
		lineageTag: 61b0339a-d453-5176-9d86-f8e946ad343a
