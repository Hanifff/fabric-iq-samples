	column 'Project Key'
		dataType: int64
		isHidden
		lineageTag: 1e5cf167-9119-5daf-938c-701cc3877d26
		sourceLineageTag: project_key
		summarizeBy: none
		sourceColumn: project_key

		annotation SummarizationSetBy = Automatic

	/// Business identifier of the project in the source system, for example PRJ-2210.
	column 'Project ID'
		dataType: string
		lineageTag: 1a73cd04-d799-5ef9-a8bd-2429476b2201
		sourceLineageTag: project_id
		summarizeBy: none
		sourceColumn: project_id

