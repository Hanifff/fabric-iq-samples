/// People who plan and execute work, with role, discipline and rate.
table Resource
	lineageTag: 98ecbd26-037a-56da-b8fe-5f6bf97ff9c7
	sourceLineageTag: [dbo].[dim_resource]

	/// Surrogate key of the resource. Minus one is the Unassigned member.
	column 'Resource Key'
		dataType: int64
		isHidden
		lineageTag: 2562de67-cde5-5006-b029-b7f18206ce3f
		sourceLineageTag: resource_key
		summarizeBy: none
		sourceColumn: resource_key

		annotation SummarizationSetBy = Automatic

	/// Business identifier of the resource, for example RES-0042. Unassigned for activities without an owner.
	column 'Resource ID'
		dataType: string
		lineageTag: 17731717-8ff2-5b38-b19b-edf2fd32b245
