/// Suppliers and contractors with category, country and quality rating. Shared by procurement and maintenance.
table Contractor
	lineageTag: bcb308bc-356f-5484-ba25-dd98d8210bde
	sourceLineageTag: [dbo].[dim_supplier]

	/// Surrogate key of the supplier. Minus one is the Not applicable member.
	column 'Supplier Key'
		dataType: int64
		isHidden
		lineageTag: 75b4dc16-bec9-52fc-a6a6-73aa7f3d86a6
		sourceLineageTag: supplier_key
		summarizeBy: none
		sourceColumn: supplier_key

		annotation SummarizationSetBy = Automatic

	/// Business identifier of the supplier, for example SUP-0087.
	column 'Supplier ID'
		dataType: string
		lineageTag: 4dfe2d86-ea80-5eb0-ab18-fa0cb2e8bb11
		sourceLineageTag: supplier_id
		summarizeBy: none
		sourceColumn: supplier_id

		annotation SummarizationSetBy = Automatic

	/// Registered name of the supplier.
	column 'Supplier Name'
		dataType: string
		lineageTag: 42800f85-7047-5fcc-94f5-9970f122d8c4
		sourceLineageTag: supplier_name
		summarizeBy: none
		sourceColumn: supplier_name

		annotation SummarizationSetBy = Automatic

