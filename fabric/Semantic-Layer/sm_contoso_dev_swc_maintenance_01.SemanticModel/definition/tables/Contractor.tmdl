	column 'Supplier Category'
		dataType: string
		lineageTag: eff4d350-908c-54d6-aa5a-05f8920878a8
		sourceLineageTag: supplier_category
		summarizeBy: none
		sourceColumn: supplier_category

		annotation SummarizationSetBy = Automatic

	/// Two-letter country code of the supplier.
	column 'Country Code'
