		lineageTag: cc3a59b6-85d9-54d8-b798-d7cdea742c14
		sourceLineageTag: approval_status
		summarizeBy: none
		sourceColumn: approval_status

		annotation SummarizationSetBy = Automatic

	/// Supplier quality rating from 1.5 to 5.0. Higher is better.
